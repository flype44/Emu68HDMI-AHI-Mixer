* DrvAsm.a -- calls the AHIsub_HardwareControl() vector of the HDMI driver.
*
* LONG DrvQuery(struct Library *driver, ULONG attribute)   (C stack arguments)
* LONG DrvControl(struct Library *driver, ULONG attribute, LONG argument)
*
* The vector is at -114 (see ahi/status.S of the driver, the same call): D0 is
* the attribute, D1 the argument (0) and A2 the audio control (NULL). The
* gateway of the driver saves every register it uses. A2 and A6 are saved
* here because the C compiler expects them preserved.

	SECTION .text

	XDEF	_DrvQuery
	XDEF	_DrvControl

	cnop 0,4

_DrvQuery:
	movem.l	a2/a6,-(sp)
	move.l	12(sp),a6
	move.l	16(sp),d0
	moveq	#0,d1
	suba.l	a2,a2
	jsr	-114(a6)
	movem.l	(sp)+,a2/a6
	rts

	cnop 0,4

_DrvControl:
	movem.l	a2/a6,-(sp)
	move.l	12(sp),a6
	move.l	16(sp),d0
	move.l	20(sp),d1
	suba.l	a2,a2
	jsr	-114(a6)
	movem.l	(sp)+,a2/a6
	rts

	end
